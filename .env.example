#--------------------------------------------------------------------
# ENVIRONMENT
# Gunakan 'production' untuk server domain resmi (r-ats.polmankab.go.id)
# Gunakan 'development' untuk lokal
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP CONFIGURATION
# Sesuaikan baseURL dengan domain aktif:
# Production: https://r-ats.polmankab.go.id/
# Lokal: http://localhost/ats/public/
#--------------------------------------------------------------------
app.baseURL = 'https://r-ats.polmankab.go.id/'
app.indexPage = ''
app.defaultLocale = 'id'
app.appTimezone = 'Asia/Makassar'

# Aktifkan jika server menggunakan HTTPS / SSL:
# app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE CONFIGURATION
# Sesuaikan kredensial MySQL di hosting/server
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = ats_polman
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
